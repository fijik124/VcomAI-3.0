class CfgFunctions
{
	#include "vcom\cfgFunctions.hpp"
};


class CfgRemoteExec
{
	// List of script functions allowed to be sent from client via remoteExec
	class Functions
	{
		mode = 1;
		jip = 0;
		class VCM_fnc_RequestSettings { allowedTargets = 2; jip = 0; };
		class VCM_fnc_ApplySettings { allowedTargets = 1; jip = 1; };
		class VCM_fnc_HearingRelay { allowedTargets = 2; jip = 0; };
		class VCM_fnc_KnowAbout { allowedTargets = 0; jip = 0; };
		class VCM_fnc_PlayAnimation { allowedTargets = 0; jip = 0; };

	};
	class Commands
	{
		mode = 0;
		jip = 0;
	};
};
