/* Owner-local acceptance for server-issued squad roles and one-shot anti-tank reservations. */
private _groups = [];
private _actors = [];
private _enemyGroup = createGroup [east,true];
_enemyGroup setVariable ["Vcm_Disable",true];
private _enemy = _enemyGroup createUnit ["O_Soldier_F",[13300,13000,0],[],0,"NONE"];
_enemy allowDamage false;
_enemy disableAI "ALL";
for "_squad" from 0 to 2 do {
    private _group = createGroup [west,true];
    _group setVariable ["VCM_Skilldisable",true];
    _group setVariable ["VCM_NOAUTOTACTICS",true];
    for "_index" from 0 to 3 do {
        private _unit = _group createUnit ["B_Soldier_F",[13000 - 25 * _squad,13000 + 8 * _index,0],[],0,"NONE"];
        _unit allowDamage false;
        _actors pushBack _unit;
    };
    _group setCombatMode "GREEN";
    _group reveal [_enemy,4];
    _group call VCM_fnc_SquadExc;
    _groups pushBack _group;
};
sleep 1.5;
VCM_CoordTimes = createHashMap;
private _issued = [_groups select 0,"squads",_enemy,[13300,13000,0]] call VCM_fnc_CoordRequest;
[_issued,"server accepts a ready multi-squad coordination request"] call _assert;
sleep 0.75;
private _roles = _groups apply {(_x getVariable ["VCM_LastSquadRole",[]]) param [0,""]};
_roles sort true;
[_roles isEqualTo ["assault","flank","support"],"three squads receive distinct assault support and flank roles"] call _assert;
[_groups findIf {_x getVariable ["VCM_Task",[]] isEqualTo []} < 0,"each squad role starts a real native tactical task"] call _assert;
private _orders = _groups apply {private _order = _x addWaypoint [[12900,12900,0],0]; _order setWaypointName "COORD_REPLACEMENT"; _order};
sleep 1;
[_groups findIf {_x getVariable ["VCM_Task",[]] isNotEqualTo []} < 0,"authored orders cancel all coordinated squad tasks"] call _assert;
[_groups findIf {_x getVariable ["VCM_CoordMission",[]] isNotEqualTo []} < 0,"cancelled squad roles release server leases"] call _assert;
{_x setVariable ["Vcm_Disable",true]} forEach _groups;
sleep 0.5;
{deleteVehicle _x} forEach _actors;
{deleteGroup _x} forEach _groups;
deleteVehicle _enemy;

private _group = createGroup [west,true];
_group setVariable ["VCM_Skilldisable",true];
_group setVariable ["VCM_NOAUTOTACTICS",true];
private _shooter = _group createUnit ["B_Soldier_F",[14000,14000,0],[],0,"NONE"];
_shooter addBackpack "B_AssaultPack_mcamo";
_shooter addMagazine "RPG32_F";
_shooter addMagazine "RPG32_F";
_shooter addWeapon "launch_RPG32_F";
_shooter allowDamage false;
_shooter setSkill 1;
_shooter setDir 90;
_group setCombatMode "GREEN";
_group setBehaviour "COMBAT";
private _target = createVehicle ["O_APC_Tracked_02_cannon_F",[14180,14000,0],[],0,"CAN_COLLIDE"];
createVehicleCrew _target;
private _targetGroup = group driver _target;
_targetGroup setVariable ["Vcm_Disable",true];
{_x disableAI "ALL"; _x allowDamage false} forEach crew _target;
_target allowDamage false;
_group reveal [_target,4];
_group call VCM_fnc_SquadExc;
sleep 1.5;
private _point = [_shooter,_target] call VCM_fnc_ContactPosition;
[_point isNotEqualTo [] && {[_shooter,_target,_point] call VCM_fnc_ATLaneClear},"known armored target has a clear native anti-tank firing lane"] call _assert;
private _friendly = _group createUnit ["B_Soldier_F",[13995,14000,0],[],0,"NONE"];
_friendly disableAI "PATH";
_friendly allowDamage false;
sleep 0.1;
[!([_shooter,_target,_point] call VCM_fnc_ATLaneClear),"friendly behind the launcher vetoes its backblast lane"] call _assert;
deleteVehicle _friendly;
_shooter setVariable ["VCM_TestRockets",0];
_shooter addEventHandler ["FiredMan",{
    params ["_unit","_weapon","_muzzle","_mode","_ammo","_magazine","_projectile"];
    if (_weapon == secondaryWeapon _unit && {!isNull _projectile}) then {
        _unit setVariable ["VCM_TestRockets",1 + (_unit getVariable ["VCM_TestRockets",0])];
    };
}];
VCM_ATLEASE = 30;
_group setCombatMode "YELLOW";
_issued = [_group,"at",_target,_point] call VCM_fnc_CoordRequest;
[_issued && {(_target getVariable ["VCM_ATLease",[]]) param [0,objNull] == _shooter},"server reserves an armored target for one shooter"] call _assert;
private _deadline = diag_tickTime + 25;
waitUntil {sleep 0.25; _shooter getVariable ["VCM_TestRockets",0] > 0 || {diag_tickTime > _deadline}};
private _fired = _target getVariable ["VCM_ATFired",[[],0]];
diag_log format ["VCM_AT_NATIVE: rockets=%1 record=%2 weapon=%3 ammo=%4 task=%5 last=%6",_shooter getVariable ["VCM_TestRockets",0],_fired,currentWeapon _shooter,_shooter ammo secondaryWeapon _shooter,_group getVariable ["VCM_Task",[]],_group getVariable ["VCM_LastTask",[]]];
[_shooter getVariable ["VCM_TestRockets",0] == 1 && {_fired select 1 == 1},"coordinated anti-tank task fires one real native rocket"] call _assert;
sleep 3;
[_shooter getVariable ["VCM_TestRockets",0] == 1,"target reservation prevents a second projectile during reload cover"] call _assert;
_group setVariable ["Vcm_Disable",true];
sleep 0.75;
[_group getVariable ["VCM_CoordMission",[]] isEqualTo [] && {_shooter getVariable ["VCM_ATWeapon",[]] isEqualTo []},"anti-tank cleanup releases the lease and weapon selection record"] call _assert;
deleteVehicle _shooter;
{deleteVehicle _x} forEach crew _target;
deleteVehicle _target;
deleteGroup _targetGroup;
deleteGroup _group;
deleteGroup _enemyGroup;
