_group = createGroup [west,true];
_group setVariable ["VCM_Skilldisable",true];
_group setVariable ["VCM_NOAUTOTACTICS",true];
_soldiers = [];
for "_i" from 0 to 3 do {
    private _unit = _group createUnit ["B_Soldier_F",[9500,9500 + 6 * _i,0],[],0,"NONE"];
