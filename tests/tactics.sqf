private _clearPlan = [_group,_enemy] call VCM_fnc_ClearBuildingPlan;
[_clearPlan isNotEqualTo [], "remembered indoor contact receives a building-entry plan"] call _assert;
if (_clearPlan isNotEqualTo []) then {
    if ((_clearPlan param [6,[]]) isNotEqualTo []) then {
        [(_clearPlan select 4 select 1 select 5 select 0) == "clearRooms","room progression delegates to the full search controller"] call _assert;
        [count (_clearPlan select 6 select 3) > 1,"full search includes multiple mapped rooms"] call _assert;
    } else {
        private _queue = (_clearPlan select 4) select [1];
        [_queue findIf {count (_x select 1) != 1} < 0,"room progression queues exactly one entry mover per phase"] call _assert;
        [count _queue <= VCM_CQBROOMS,"room progression respects the configured position limit"] call _assert;
    };
    [count (_clearPlan select 1) == 2 && {count (_clearPlan select 2) == 2}, "building plan splits outside support and entry teams"] call _assert;
    [((_clearPlan select 1) arrayIntersect (_clearPlan select 2)) isEqualTo [], "building roles do not overlap"] call _assert;
    _job = [_group,_enemy] spawn VCM_fnc_ClearBuilding;
    sleep 0.5;
    _state = _group getVariable ["VCM_Task",[]];
    [_state isNotEqualTo [] && {_state select 1 == "clear"}, "native entry task starts"] call _assert;
    diag_log format ["VCM_ENTRY_START: %1",(_clearPlan select 2) apply {[_x getVariable ["VCM_LastTaskMove",[]],_x getVariable ["VCM_MovementControl",[]],_x checkAIFeature "TARGET",_x checkAIFeature "FSM",currentCommand _x]}];
    private _roles = _soldiers apply {(_x getVariable ["VCM_TaskRole",[]]) param [1,""]};
    [{_x == "support"} count _roles == 2 && {{_x == "move"} count _roles == 2}, "entry and outside support roles reach the actual soldiers"] call _assert;
    private _deadline = diag_tickTime + 24;
    waitUntil {sleep 0.25; ((_group getVariable ["VCM_Task",[]]) param [3,0]) >= 2 || {scriptDone _job} || {diag_tickTime > _deadline}};
    diag_log format ["VCM_ENTRY_STATE: task=%1; last=%2; units=%3; stages=%4",_group getVariable ["VCM_Task",[]],_group getVariable ["VCM_LastTask",[]],(_clearPlan select 2) apply {[getPosATL _x,currentCommand _x,_x getVariable ["VCM_LastTaskMove",[]]]},(_clearPlan select 4 select 0 select 2)];
    [((_group getVariable ["VCM_Task",[]]) param [3,0]) >= 2, "entry team physically completes its approach before room movement"] call _assert;
    _order = _group addWaypoint [[9450,9450,0],0];
    _order setWaypointName "CLEAR_ABORT_ORDER";
    sleep 0.75;
    [scriptDone _job && {_group getVariable ["VCM_Task",[]] isEqualTo []}, "new order cancels building clearing and releases its roles"] call _assert;
    deleteWaypoint _order;
};
