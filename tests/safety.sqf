/* Real geometry, native firing, inventory conservation and native thrown projectiles. */
private _saved = [VCM_WALLCHECK, VCM_NOGRENADESINDOORS, VCM_FIREMOVEMENT, VCM_ADVANCEDMOVEMENT, +VCM_BARRACKSCLASSES];
VCM_WALLCHECK = true;
VCM_NOGRENADESINDOORS = true;
VCM_FIREMOVEMENT = false;
VCM_ADVANCEDMOVEMENT = false;
private _group = createGroup [west, true];
_group setVariable ["VCM_Skilldisable", true];
private _unit = _group createUnit ["B_Soldier_F", [8000,8000,0], [], 0, "NONE"];
_unit setPosATL [8000,8000,0];
_unit setDir 90;
_unit allowDamage false;
_unit disableAI "PATH";
_unit setUnitPos "UP";
private _opfor = createGroup [east, true];
_opfor setVariable ["Vcm_Disable", true];
private _target = _opfor createUnit ["O_Soldier_F", [8040,8000,0], [], 0, "NONE"];
_target setPosATL [8040,8000,0];
_target allowDamage false;
_target disableAI "ALL";
_group setCombatMode "YELLOW";
_group setBehaviour "COMBAT";
_group reveal [_target,4];
_group call VCM_fnc_SquadExc;
VCM_TestSafetyShots = 0;
_unit addEventHandler ["Fired", {if (_this select 1 != "Throw") then {VCM_TestSafetyShots = VCM_TestSafetyShots + 1}}];
_unit doTarget _target;
_unit doFire _target;
private _deadline = diag_tickTime + 12;
waitUntil {sleep 0.1; VCM_TestSafetyShots > 0 || {diag_tickTime > _deadline}};
[VCM_TestSafetyShots > 0, "native infantry fires at an unobstructed target"] call _assert;
private _wall = createVehicle ["Land_CncWall4_F", [8020,8000,0], [], 0, "CAN_COLLIDE"];
_wall setDir 90;
_wall setPosATL [8020,8000,0];
sleep 1;
private _contact = [_unit,_target] call VCM_fnc_ContactPosition;
[!([eyePos _unit, ATLToASL (_contact vectorAdd [0,0,1]), _unit, _target] call VCM_fnc_PhysicalFireLane),
    "concrete wall obstructs the physical firing path"] call _assert;
[!(_unit checkAIFeature "FIREWEAPON"), "safety monitor blocks native firing at a wall-obstructed target"] call _assert;
private _shots = VCM_TestSafetyShots;
sleep 2;
[VCM_TestSafetyShots == _shots, "native infantry emits no shots while the wall blocks firing"] call _assert;
_wall setPosATL [8020,8020,0];
_unit doTarget _target;
_unit doFire _target;
_deadline = diag_tickTime + 8;
waitUntil {sleep 0.1; VCM_TestSafetyShots > _shots || {diag_tickTime > _deadline}};
[_unit checkAIFeature "FIREWEAPON" && {VCM_TestSafetyShots > _shots}, "firing resumes after the obstruction moves away"] call _assert;
_unit disableAI "FIREWEAPON";
[_unit, _group getVariable ["VCM_RunId", []]] call VCM_fnc_SafetyTick;
[!(_unit checkAIFeature "FIREWEAPON"), "safety does not enable firing disabled by the mission"] call _assert;
_unit enableAI "FIREWEAPON";
_wall setPosATL [8020,8000,0];
sleep 0.5;
VCM_WALLCHECK = false;
_deadline = diag_tickTime + 2;
waitUntil {sleep 0.05; _unit checkAIFeature "FIREWEAPON" || {diag_tickTime > _deadline}};
[_unit checkAIFeature "FIREWEAPON", "disabling wall checks restores the owned firing feature"] call _assert;
VCM_WALLCHECK = true;
_group setVariable ["Vcm_Disable", true];
sleep 0.5;
[_unit checkAIFeature "FIREWEAPON", "controller cleanup restores its firing lock"] call _assert;

private _throwGroup = createGroup [west,true];
_throwGroup setVariable ["VCM_Skilldisable", true];
// Reserve a controlled test group from the automatic scanner; BindUnits still installs the real product handlers.
VcmAI_ActiveList pushBack _throwGroup;
private _throwRun = [clientOwner,900000];
_throwGroup setVariable ["VCM_RunId",_throwRun];
private _thrower = _throwGroup createUnit ["B_Soldier_F", [8200,8200,0], [], 0, "NONE"];
_thrower allowDamage false;
_thrower enableSimulationGlobal false;
[_throwGroup] call VCM_fnc_BindUnits;
private _barracks = createVehicle ["Land_i_Barracks_V1_F", [8200,8200,0], [], 0, "CAN_COLLIDE"];
sleep 0.2;
private _inside = [];
{_thrower setPosATL _x; if ([_thrower] call VCM_fnc_InsideBarracks) exitWith {_inside = _x}} forEach (_barracks buildingPos -1);
[_inside isNotEqualTo [], "real barracks geometry identifies an interior position"] call _assert;
{_thrower removeMagazines _x} forEach compatibleMagazines "Throw";
_thrower addMagazine "HandGrenade";
_thrower addMagazine "HandGrenade";
_thrower addMagazine "SmokeShell";
[_thrower,_throwRun,true] call VCM_fnc_SafetyTick;
[({(_x select 0) in compatibleMagazines "Throw"} count magazinesAmmoFull _thrower) == 0,
    "indoor barracks removes available grenade and smoke throws"] call _assert;
[count (_thrower getVariable ["VCM_StoredGrenades",[]]) == 3, "all three thrown magazines are conserved in storage"] call _assert;
[_thrower,_throwRun,true] call VCM_fnc_SafetyTick;
[count (_thrower getVariable ["VCM_StoredGrenades",[]]) == 3, "repeated indoor checks do not duplicate stored grenades"] call _assert;
_thrower setPosATL [8250,8200,0];
[!([_thrower] call VCM_fnc_InsideBarracks), "outdoors beside a barracks is not classified as indoors"] call _assert;
[_thrower,_throwRun,true] call VCM_fnc_SafetyTick;
[{_x == "HandGrenade"} count magazines _thrower == 2 && {{_x == "SmokeShell"} count magazines _thrower == 1},
    "leaving the barracks restores the exact grenade counts"] call _assert;
[_thrower getVariable ["VCM_StoredGrenades",[]] isEqualTo [], "restoring grenades clears the ownership record"] call _assert;

// Force a real throw before a safety scan can remove its magazine. The Fired handler is the fallback guard.
_thrower setPosATL _inside;
_thrower enableSimulationGlobal true;
_thrower disableAI "PATH";
doStop _thrower;
_thrower selectThrowable "HandGrenade";
sleep 0.5;
diag_log format ["VCM_THROW_STATE: %1; throwable=%2; indoors=%3", _thrower weaponState "HandGrenadeMuzzle", currentThrowable _thrower, [_thrower] call VCM_fnc_InsideBarracks];
_deadline = diag_tickTime + 5;
waitUntil {sleep 0.1; ((_thrower weaponState "HandGrenadeMuzzle") param [6,1]) == 0 || {diag_tickTime > _deadline}};
_thrower forceWeaponFire ["HandGrenadeMuzzle","HandGrenadeMuzzle"];
_deadline = diag_tickTime + 5;
waitUntil {sleep 0.1; _thrower getVariable ["VCM_BlockedThrows",0] > 0 || {diag_tickTime > _deadline}};
[_thrower getVariable ["VCM_BlockedThrows",0] > 0, "real Fired handler cancels an indoor grenade projectile"] call _assert;
_thrower enableSimulationGlobal false;
_thrower setPosATL [8250,8200,0];
[_thrower,_throwRun,true] call VCM_fnc_SafetyTick;
[{_x == "HandGrenade"} count magazines _thrower == 2, "cancelled indoor throw conserves its grenade"] call _assert;
VCM_TestOutdoorGrenade = objNull;
_thrower addEventHandler ["FiredMan", {if (_this select 1 == "Throw") then {VCM_TestOutdoorGrenade = _this select 6}}];
_thrower enableSimulationGlobal true;
_thrower selectThrowable "HandGrenade";
_deadline = diag_tickTime + 5;
waitUntil {sleep 0.1; ((_thrower weaponState "HandGrenadeMuzzle") param [6,1]) == 0 || {diag_tickTime > _deadline}};
_thrower forceWeaponFire ["HandGrenadeMuzzle","HandGrenadeMuzzle"];
_deadline = diag_tickTime + 5;
waitUntil {sleep 0.1; !isNull VCM_TestOutdoorGrenade || {diag_tickTime > _deadline}};
[!isNull VCM_TestOutdoorGrenade, "native outdoor grenade throw remains active"] call _assert;
deleteVehicle VCM_TestOutdoorGrenade;
[{_x == "HandGrenade"} count magazines _thrower == 1, "allowed outdoor throw consumes exactly one grenade"] call _assert;
_thrower enableSimulationGlobal false;
private _house = createVehicle ["Land_i_House_Big_01_V1_F", [8300,8200,0], [], 0, "CAN_COLLIDE"];
sleep 0.2;
private _housePoint = (_house buildingPos -1) select 0;
_thrower setPosATL _housePoint;
[!([_thrower] call VCM_fnc_InsideBarracks), "ordinary houses are not restricted by the barracks-only default"] call _assert;
VCM_BARRACKSCLASSES = ["Land_i_House_Big_01_V1_F"];
private _custom = false;
{_thrower setPosATL _x; if ([_thrower] call VCM_fnc_InsideBarracks) exitWith {_custom = true}} forEach (_house buildingPos -1);
[_custom, "explicit building class override supports additional barracks models"] call _assert;
[_thrower,_throwRun,true] call VCM_fnc_SafetyTick;
VCM_NOGRENADESINDOORS = false;
[_thrower,_throwRun,true] call VCM_fnc_SafetyTick;
[count (_thrower getVariable ["VCM_StoredGrenades",[]]) == 0 && {"HandGrenade" in magazines _thrower},
    "disabling indoor grenade restriction restores stored inventory"] call _assert;
[_throwGroup,_throwRun] call VCM_fnc_CleanupGroup;
{deleteVehicle _x} forEach [_unit,_target,_wall,_thrower,_barracks,_house];
{deleteGroup _x} forEach [_group,_opfor,_throwGroup];
_saved params ["_wallCheck","_noGrenades","_fire","_advanced","_classes"];
VCM_WALLCHECK = _wallCheck;
VCM_NOGRENADESINDOORS = _noGrenades;
VCM_FIREMOVEMENT = _fire;
VCM_ADVANCEDMOVEMENT = _advanced;
VCM_BARRACKSCLASSES = _classes;
