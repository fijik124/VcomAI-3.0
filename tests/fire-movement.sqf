/* Runs inside regression.sqf's scheduled context and uses its assertion function. */
private _savedSettings = [VCM_FIREMOVEMENT, VCM_ADVANCEDMOVEMENT, VCM_BOUNDLENGTH, VCM_BOUNDSECONDS];
VCM_FIREMOVEMENT = false;
VCM_ADVANCEDMOVEMENT = true;
VCM_BOUNDLENGTH = 10;
VCM_BOUNDSECONDS = 12;
private _squad = createGroup [west, true];
_squad setVariable ["VCM_Skilldisable", true];
private _positions = [[6000,5985,0], [6000,6015,0], [5995,5980,0], [5995,6020,0]];
private _soldiers = [];
{
    private _soldier = _squad createUnit [_x, _positions select _forEachIndex, [], 0, "NONE"];
    _soldier setPosATL (_positions select _forEachIndex);
    _soldier setDir 90;
    _soldier allowDamage false;
    _soldiers pushBack _soldier;
} forEach ["B_Soldier_F", "B_Soldier_F", "B_Soldier_F", "B_Soldier_AR_F"];
private _opfor = createGroup [east, true];
private _target = _opfor createUnit ["O_Soldier_F", [6200,6000,0], [], 0, "NONE"];
_opfor setVariable ["Vcm_Disable", true];
_target setPosATL [6200,6000,0];
_target disableAI "ALL";
_target allowDamage false;
_squad setCombatMode "YELLOW";
_squad setBehaviour "COMBAT";
_squad call VCM_fnc_SquadExc;
sleep 0.5;
VCM_FIREMOVEMENT = true;
_squad reveal [_target, 4];
private _leader = leader _squad;
private _gunner = _soldiers select 3;
private _plan = [_leader] call VCM_fnc_FireMovePlan;
[_plan isNotEqualTo [], "four eligible infantry receive a fire-and-movement plan"] call _assert;
if (_plan isNotEqualTo []) then {
    private _support = _plan select 2;
    private _movers = _plan select 3;
    [count _support == 2 && {count _movers == 2}, "balanced two-team plan"] call _assert;
    [(_support arrayIntersect _movers) isEqualTo [], "support and movement teams do not overlap"] call _assert;
    [_gunner in _support, "machine gunner receives initial support role"] call _assert;
};
_squad setVariable ["VCM_NOFLANK", true];
[([_leader] call VCM_fnc_FireMovePlan) isEqualTo [], "NOFLANK blocks coordinated movement"] call _assert;
_squad setVariable ["VCM_NOFLANK", false];
_squad setCombatMode "GREEN";
[([_leader] call VCM_fnc_FireMovePlan) isEqualTo [], "hold-fire order blocks coordinated movement"] call _assert;
_squad setCombatMode "YELLOW";
(_soldiers select 1) setVariable ["VCM_MoveKey", ["reserved"]];
[([_leader] call VCM_fnc_FireMovePlan) isEqualTo [], "reserved movement task excludes its soldier"] call _assert;
(_soldiers select 1) setVariable ["VCM_MoveKey", nil];
(_soldiers select 1) setUnitTrait ["Medic", true];
[([_leader] call VCM_fnc_FireMovePlan) isEqualTo [], "medic duties are preserved"] call _assert;
(_soldiers select 1) setUnitTrait ["Medic", false];
(_soldiers select 1) setSuppression 1;
[([_leader] call VCM_fnc_FireMovePlan) isEqualTo [], "heavy suppression prevents an advance"] call _assert;
(_soldiers select 1) setSuppression 0;
private _authored = _squad addWaypoint [[6050,6100,0], 0];
_authored setWaypointName "BOUND_AUTHORED";
[([_leader] call VCM_fnc_FireMovePlan) isEqualTo [], "authored route blocks a coordinated maneuver"] call _assert;
deleteWaypoint _authored;

private _contact = [_leader, _target] call VCM_fnc_ContactPosition;
[[_gunner, _contact, _target] call VCM_fnc_FireLaneClear, "unobstructed fire lane accepted"] call _assert;
private _civilianGroup = createGroup [civilian, true];
private _midpoint = ((getPosATL _gunner) vectorAdd _contact) vectorMultiply 0.5;
_midpoint set [2,0];
private _civilian = _civilianGroup createUnit ["C_man_1", _midpoint, [], 0, "NONE"];
_civilian setPosATL _midpoint;
_civilian enableSimulationGlobal false;
sleep 0.1;
[!([_gunner, _contact, _target] call VCM_fnc_FireLaneClear), "civilian in the fire lane vetoes scripted suppression"] call _assert;
deleteVehicle _civilian;
deleteGroup _civilianGroup;
sleep 0.2;

VCM_TestBoundShots = 0;
private _shotHandlers = _soldiers apply {[_x, _x addEventHandler ["Fired", {VCM_TestBoundShots = VCM_TestBoundShots + 1}]]};
private _startPositions = _soldiers apply {getPosATL _x};
private _features = _soldiers apply {[_x checkAIFeature "PATH", _x checkAIFeature "TARGET", _x checkAIFeature "AUTOCOMBAT"]};
private _job = [_leader] spawn VCM_fnc_FireMove;
sleep 0.25;
private _state = _squad getVariable ["VCM_BoundState", []];
[_state isNotEqualTo [], "coordinated maneuver starts"] call _assert;
if (_state isNotEqualTo []) then {
    private _key = _state select 0;
    [_leader] call VCM_fnc_ForceMove;
    [_leader] call VCM_fnc_FlankMove;
    private _duplicate = [_leader] spawn VCM_fnc_FireMove;
    [_squad, [[-1,-1],-1]] call VCM_fnc_EndFireMove;
    sleep 0.25;
    [scriptDone _duplicate, "duplicate maneuver exits"] call _assert;
    [((_squad getVariable ["VCM_BoundState", []]) param [0, []]) isEqualTo _key, "other movement and stale cleanup cannot replace an active maneuver"] call _assert;
};
private _swapped = false;
private _deadline = diag_tickTime + 35;
waitUntil {
    sleep 0.25;
    private _current = _squad getVariable ["VCM_BoundState", []];
    if (_current isNotEqualTo [] && {_current select 2 == 2}) then {_swapped = true};
    scriptDone _job || {diag_tickTime >= _deadline}
};
private _result = _squad getVariable ["VCM_LastBound", ["", [0,0]]];
diag_log format ["VCM_BOUND_RESULT: %1; shots=%2", _result, VCM_TestBoundShots];
[scriptDone _job, "maneuver finishes within its deadline"] call _assert;
[_swapped, "teams exchange support and movement roles"] call _assert;
[(_result select 0) == "completed" && {_result select 1 select 1 == 2}, "both advances complete"] call _assert;
[(_result select 1 select 0) > 0 && {VCM_TestBoundShots > 0}, "support issues suppression pulses and native AI fires"] call _assert;
private _moved = false;
{if (_x distance2D (_startPositions select _forEachIndex) > 3) then {_moved = true}} forEach _soldiers;
[_moved, "maneuver produces physical movement"] call _assert;
[(_squad getVariable ["VCM_BoundState", []]) isEqualTo [], "finished maneuver releases its group reservation"] call _assert;
[_soldiers findIf {(_x getVariable ["VCM_BoundKey", []]) isNotEqualTo []} < 0, "finished maneuver releases soldier reservations"] call _assert;
[count (waypoints _squad) <= 1, "coordinated movement does not add waypoints"] call _assert;

private _reset = {
    VCM_FIREMOVEMENT = false;
    {
        _x setPosATL (_positions select _forEachIndex);
        _x setAmmo [primaryWeapon _x, 200];
        _x setSuppression 0;
    } forEach _soldiers;
    _squad reveal [_target, 4];
    _squad setVariable ["VCM_NextBound", -1];
    VCM_FIREMOVEMENT = true;
};
call _reset;
_job = [_leader] spawn VCM_fnc_FireMove;
sleep 0.25;
[(_squad getVariable ["VCM_BoundState", []]) isNotEqualTo [], "new maneuver starts after resetting the cooldown"] call _assert;
VCM_FIREMOVEMENT = false;
sleep 0.75;
[scriptDone _job && {(_squad getVariable ["VCM_BoundState", []]) isEqualTo []}, "feature disable cancels a running maneuver"] call _assert;
call _reset;
_job = [_leader] spawn VCM_fnc_FireMove;
sleep 0.25;
_authored = _squad addWaypoint [[6050,6100,0], 0];
_authored setWaypointName "BOUND_NEW_ORDER";
sleep 0.75;
[scriptDone _job, "new mission order cancels the maneuver"] call _assert;
[(waypoints _squad) findIf {waypointName _x == "BOUND_NEW_ORDER"} >= 0, "new mission order survives cancellation"] call _assert;
deleteWaypoint _authored;
private _unchanged = true;
{
    if !([_x checkAIFeature "PATH", _x checkAIFeature "TARGET", _x checkAIFeature "AUTOCOMBAT"] isEqualTo (_features select _forEachIndex)) then {_unchanged = false};
} forEach _soldiers;
[_unchanged, "maneuvers preserve native AI features"] call _assert;

{(_x select 0) removeEventHandler ["Fired", _x select 1]} forEach _shotHandlers;
_squad setVariable ["Vcm_Disable", true];
sleep 0.5;
{deleteVehicle _x} forEach _soldiers;
deleteVehicle _target;
deleteGroup _squad;
deleteGroup _opfor;
_savedSettings params ["_fireMovement", "_advanced", "_length", "_seconds"];
VCM_FIREMOVEMENT = _fireMovement;
VCM_ADVANCEDMOVEMENT = _advanced;
VCM_BOUNDLENGTH = _length;
VCM_BOUNDSECONDS = _seconds;
