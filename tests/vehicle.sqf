/* Native mounted firing safety with a fresh crew and physical geometry. */
private _vehicle = createVehicle ["B_APC_Wheeled_01_cannon_F",[14000,14000,0],[],0,"CAN_COLLIDE"];
_vehicle setPosATL [14000,14000,0];
_vehicle setDir 90;
_vehicle allowDamage false;
_vehicle setFuel 0;
createVehicleCrew _vehicle;
private _group = group driver _vehicle;
_group setVariable ["VCM_Skilldisable",true];
_group setVariable ["VCM_NOAUTOTACTICS",true];
{_x allowDamage false} forEach crew _vehicle;
private _opfor = createGroup [east,true];
_opfor setVariable ["Vcm_Disable",true];
private _enemy = _opfor createUnit ["O_Soldier_F",[14080,14000,0],[],0,"NONE"];
_enemy setPosATL [14080,14000,0];
_enemy disableAI "ALL";
_enemy allowDamage false;
_group setCombatMode "YELLOW";
_group call VCM_fnc_SquadExc;
_vehicle reveal [_enemy,4];
gunner _vehicle doTarget _enemy;
sleep 1;
private _wall = createVehicle ["Land_i_Barracks_V1_F",[14030,14000,0],[],0,"CAN_COLLIDE"];
_wall setPosATL [14030,14000,0];
_wall allowDamage false;
sleep 1;
private _position = [gunner _vehicle,_enemy] call VCM_fnc_ContactPosition;
diag_log format ["VCM_VEHICLE_GEOMETRY: start=%1 end=%2 contact=%3 wall=%4 hits=%5",eyePos gunner _vehicle,eyePos _enemy,_position,getPosASL _wall,lineIntersectsSurfaces [eyePos gunner _vehicle,eyePos _enemy,_vehicle,_enemy,true,5,"FIRE","GEOM"]];
[!([eyePos gunner _vehicle,eyePos _enemy,_vehicle,_enemy] call VCM_fnc_PhysicalFireLane),"building blocks the mounted gunner's physical firing lane"] call _assert;
gunner _vehicle doTarget _enemy;
gunner _vehicle doFire _enemy;
sleep 1;
[!(gunner _vehicle checkAIFeature "FIREWEAPON"),"direct-fire vehicle gunner holds fire behind physical cover"] call _assert;
deleteVehicle _wall;
sleep 1;
[gunner _vehicle checkAIFeature "FIREWEAPON","vehicle gunner firing feature returns when the lane clears"] call _assert;
_group setVariable ["Vcm_Disable",true];
sleep 0.5;
{deleteVehicle _x} forEach (crew _vehicle + [_vehicle,_enemy]);
{deleteGroup _x} forEach [_group,_opfor];
